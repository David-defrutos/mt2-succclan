{
    "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
    "cards": [
        {
            "id": "DarkPact",
            "names": {
                "english": "Dark Pact",
                "chinese": "黑暗契约"
            },
            "descriptions": {
                "english": "Shuffle [effect0.power_unmodified] <b>Obsessing Spark</b> with [consume] into your deck. +[effect1.power][ember] every turn.",
                "chinese": "将 [effect0.power_unmodified] 张带有[consume]的<b>欲望碎片</b>洗入牌库。每回合 +[effect1.power][ember]。"
            },
            "card_type": "spell",
            "rarity": "uncommon",
            "class": "@ClassSuccubus",
            "card_art": "@DarkPactArt",
            "cost": 1,
            "targets_room": true,
            "targetless": true,
            "pools": [
                "MegaPool"
            ],
            "traits": [
                "@Consume"
            ],
            "effects": [
                "@DarkPactShards",
                "@DarkPactEmber"
            ]
        }
    ],
    "effects": [
        {
            "id": "DarkPactShards",
            "name": "CardEffectAddBattleCard",
            "target_mode": "room",
            "target_team": "none",
            "param_int": 7,
            "param_int_2": 2,
            "param_card_pool": "@ObsessingShardPool",
            "param_upgrade": "@ConsumeUpgrade"
        },
        {
            "id": "DarkPactEmber",
            "name": "CardEffectGainEnergyEveryTurn",
            "target_mode": "self",
            "target_team": "none",
            "param_int": 1
        }
    ],
    "sprites": [
        {
            "id": "DarkPactArt",
            "path": "textures/DarkPactArt.png"
        }
    ],
    "game_objects": [
        {
            "id": "DarkPactArt",
            "type": "card_art",
            "extensions": {
                "card_art": {
                    "sprite": "@DarkPactArt"
                }
            }
        }
    ]
}
