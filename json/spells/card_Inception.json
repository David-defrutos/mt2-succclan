                "russian": "Даёт союзнику <b>[mt2_succclan.Plugin_psionic] [effect0.status0.power]</b>, +[effect1.power][attack] и +[effect2.power][health].",
                "portuguese": "Aplica <b>[mt2_succclan.Plugin_psionic] [effect0.status0.power]</b>, +[effect1.power][attack] e +[effect2.power][health] a uma unidade aliada.",
                "chinese": "对一个友方单位施加<b>[mt2_succclan.Plugin_psionic] [effect0.status0.power]</b>、+[effect1.power][attack]和+[effect2.power][health]。",
                "chinese_traditional": "對一個友方單位施加<b>[mt2_succclan.Plugin_psionic] [effect0.status0.power]</b>、+[effect1.power][attack]和+[effect2.power][health]。",
                "korean": "아군 유닛 하나에게 <b>[mt2_succclan.Plugin_psionic] [effect0.status0.power]</b>, +[effect1.power][attack] 및 +[effect2.power][health]을 부여합니다.",
                "japanese": "味方ユニット1体に<b>[mt2_succclan.Plugin_psionic] [effect0.status0.power]</b>、+[effect1.power][attack]、+[effect2.power][health]を付与する。"
            },
            "card_type": "spell",
            "rarity": "common",
            "class": "@ClassSuccubus",
            "card_art": "@InceptionArt",
            "cost": 1,
            "targets_room": true,
            "targetless": false,
            "effects": [
                "@InceptionPsionic",
                "@InceptionAttack",
                "@InceptionHealth"
            ],
            "pools": [
                "StarterCardsOnly"
            ]
        }
    ],
    "effects": [
        {
            "id": "InceptionPsionic",
            "name": "CardEffectAddStatusEffect",
            "target_mode": "drop_target_character",
            "target_team": "monsters",
            "param_status_effects": [
                {
                    "status": "@psionic",
                    "count": 1
                }
            ]
        },
        {
            "id": "InceptionAttack",
            "applied_vfx": "@SuccFXAttackBuff",
            "name": "CardEffectAddCardUpgradeToUnits",
            "target_mode": "last_targeted_characters",
            "target_team": "monsters",
            "param_int": 2,
            "param_upgrade": "@BattleGrowthInceptionAttack",
            "param_int_3": 0
        },
        {
            "id": "InceptionHealth",
            "applied_vfx": "@SuccFXHealthBuff",
            "name": "CardEffectAddCardUpgradeToUnits",
            "target_mode": "last_targeted_characters",
            "target_team": "monsters",
            "param_int": 2,
            "param_upgrade": "@BattleGrowthInceptionHealth",
            "param_int_3": 0
        }
    ],
    "sprites": [
