{
    "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
    "cards": [
        {
            "id": "Inception",
            "names": {
                "english": "Inception",
                "chinese": "思想窃取",
                "spanish": "Implantación",
                "french": "Implantation",
                "german": "Einpflanzung",
                "portuguese": "Implantação",
                "russian": "Внедрение",
                "chinese_traditional": "植入",
                "japanese": "植え付け",
                "korean": "주입"
            },
            "descriptions": {
                "english": "Apply <b>[mt2_succclan.Plugin_psionic] [effect0.status0.power]</b>, +[effect1.power][attack] and +[effect2.power][health] to a friendly unit.",
                "spanish": "Añade <b>[mt2_succclan.Plugin_psionic] [effect0.status0.power]</b>, +[effect1.power][attack] y +[effect2.power][health] a una unidad aliada.",
                "french": "Applique <b>[mt2_succclan.Plugin_psionic] [effect0.status0.power]</b>, +[effect1.power][attack] et +[effect2.power][health] à une unité alliée.",
