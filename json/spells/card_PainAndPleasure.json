{
    "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
    "cards": [
        {
            "id": "PainAndPleasure",
            "names": {
                "english": "Pain And Pleasure",
                "chinese": "喜怒无常"
            },
            "descriptions": {
                "english": "Requires [effect0.power] <b>Obsessing Spark</b> in hand. Discard them and draw [effect1.power] cards.",
                "chinese": "需要手牌中有 [effect0.power] 张<b>欲望碎片</b>。舍弃这些牌并抽 [effect1.power] 张牌。"
            },
            "card_type": "spell",
            "rarity": "common",
            "class": "@ClassSuccubus",
            "card_art": "@PainAndPleasureArt",
            "cost": 0,
            "targets_room": true,
            "targetless": true,
            "pools": [
                "MegaPool"
            ],
            "effects": [
                "@PainAndPleasureDiscard",
                "@PainAndPleasureDraw"
            ]
        }
    ],
    "effects": [
        {
            "id": "PainAndPleasureDiscard",
            "name": "@CardEffectDiscardSpecificCard",
            "should_fail_to_cast_if_test_fails": true,
            "should_cancel_subsequent_effects_if_test_fails": true,
            "target_mode": "room",
            "target_team": "none",
            "target_card_type": "blight",
            "param_int": 2,
            "param_card": "@ObsessingShard"
        },
        {
            "id": "PainAndPleasureDraw",
            "name": "CardEffectDraw",
            "target_mode": "room",
            "target_team": "none",
            "param_int": 3
        }
    ],
    "sprites": [
        {
            "id": "PainAndPleasureArt",
            "path": "textures/PainAndPleasureArt.png"
        }
    ],
    "game_objects": [
        {
            "id": "PainAndPleasureArt",
            "type": "card_art",
            "extensions": {
                "card_art": {
                    "sprite": "@PainAndPleasureArt"
                }
            }
        }
    ]
}
