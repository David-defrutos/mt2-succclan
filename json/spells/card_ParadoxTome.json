{
    "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
    "cards": [
        {
            "id": "ParadoxTome",
            "names": {
                "english": "Paradox Tome",
                "chinese": "悖论法典"
            },
            "descriptions": {
                "english": "Apply [sweep] to a friendly unit. Add [effect1.secondarypower] <b>Obsessing Spark</b> with [consume] to your hand.",
                "chinese": "对一个友方单位施加[sweep]。将 [effect1.secondarypower] 张带有[consume]的<b>欲望碎片</b>加入手牌。"
            },
            "card_type": "spell",
            "rarity": "rare",
            "class": "@ClassSuccubus",
            "card_art": "@ParadoxTomeArt",
            "cost": 3,
            "targets_room": true,
            "targetless": false,
            "pools": [
                "MegaPool"
            ],
            "traits": [
                "@Consume"
            ],
            "effects": [
                "@ParadoxTomeSweep",
                "@ParadoxTomeShards"
            ]
        }
