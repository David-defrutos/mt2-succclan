{
    "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
    "cards": [
        {
            "id": "ProfaneAscending",
            "names": {
                "english": "Profane Ascending",
                "chinese": "亵渎晋升"
            },
            "descriptions": {
                "english": "<b>Ascend</b> an enemy unit. Apply <b>[mt2_succclan.Plugin_frantic] [effect1.status0.power]</b> and heal it for [effect2.power][health].",
                "chinese": "使一个敌方单位<b>上升</b>一层，施加 <b>[mt2_succclan.Plugin_frantic] [effect1.status0.power]</b>，并为其恢复 [effect2.power] 点[health]。"
            },
            "card_type": "spell",
            "rarity": "common",
            "class": "@ClassSuccubus",
            "card_art": "@ProfaneAscendingArt",
            "cost": 1,
            "targets_room": true,
            "targetless": false,
            "pools": [
                "MegaPool",
                "SpellsNotAllowedSpellPowerPool"
            ],
            "effects": [
                "@PABump",
                "@PAFrantic",
                "@PAHeal"
            ]
        }
    ],
    "effects": [
        {
            "id": "PABump",
            "name": "CardEffectBump",
            "target_mode": "drop_target_character",
            "target_team": "heroes",
            "param_int": 1
        },
        {
            "id": "PAFrantic",
            "name": "CardEffectAddStatusEffect",
            "target_mode": "last_targeted_characters",
            "target_team": "both",
            "param_status_effects": [
                {
                    "status": "@frantic",
                    "count": 1
                }
            ]
        },
        {
            "id": "PAHeal",
            "name": "CardEffectHeal",
            "target_mode": "last_targeted_characters",
            "target_team": "heroes",
            "param_int": 100
        }
    ],
    "sprites": [
        {
            "id": "ProfaneAscendingArt",
            "path": "textures/ProfaneAscendingArt.png"
        }
    ],
    "game_objects": [
        {
            "id": "ProfaneAscendingArt",
            "type": "card_art",
            "extensions": {
                "card_art": {
                    "sprite": "@ProfaneAscendingArt"
                }
            }
        }
    ]
}
