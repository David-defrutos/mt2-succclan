{
    "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
    "cards": [
        {
            "id": "DangerousGame",
            "names": {
                "english": "Dangerous Game",
                "chinese": "危险的游戏"
            },
            "descriptions": {
                "english": "Apply <b>[mt2_succclan.Plugin_frantic] [effect0.status0.power]</b>, +[effect1.power][attack] and [armor] [effect2.status0.power] to enemy units.",
                "chinese": "对所有敌方单位施加 <b>[mt2_succclan.Plugin_frantic] [effect0.status0.power]</b>、+[effect1.power][attack] 和[armor] [effect2.status0.power]。"
            },
            "card_type": "spell",
            "rarity": "uncommon",
            "class": "@ClassSuccubus",
            "card_art": "@DangerousGameArt",
            "cost": 1,
            "targets_room": true,
            "targetless": true,
            "pools": [
                "MegaPool"
            ],
            "effects": [
                "@DangerousGameFrantic",
                "@DangerousGameAttack",
                "@DangerousGameArmor"
            ]
        }
    ],
    "effects": [
        {
            "id": "DangerousGameFrantic",
            "name": "CardEffectAddStatusEffect",
            "target_mode": "room",
            "target_team": "heroes",
            "param_status_effects": [
                {
                    "status": "@frantic",
                    "count": 1
                }
            ]
        },
        {
            "id": "DangerousGameAttack",
            "name": "CardEffectBuffDamage",
            "target_mode": "room",
            "target_team": "heroes",
            "param_int": 10
        },
        {
            "id": "DangerousGameArmor",
            "name": "CardEffectAddStatusEffect",
            "target_mode": "room",
            "target_team": "heroes",
            "param_status_effects": [
                {
                    "status": "armor",
                    "count": 30
                }
            ]
        }
    ],
    "sprites": [
        {
            "id": "DangerousGameArt",
            "path": "textures/DangerousGameArt.png"
        }
    ],
    "game_objects": [
        {
            "id": "DangerousGameArt",
            "type": "card_art",
            "extensions": {
                "card_art": {
                    "sprite": "@DangerousGameArt"
                }
            }
        }
    ]
