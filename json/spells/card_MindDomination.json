{
    "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
    "cards": [
        {
            "id": "MindDomination",
            "names": {
                "english": "Mind Domination",
                "chinese": "支配他人"
            },
            "descriptions": {
                "english": "<b>Descend</b> a unit, apply <b>[mt2_succclan.Plugin_frantic] [effect2.status0.power]</b> and fully heal it. Add 1 <b>Obsessing Spark</b> with [consume] to your hand.",
                "chinese": "使一个单位<b>下降</b>，施加 <b>[mt2_succclan.Plugin_frantic] [effect2.status0.power]</b>，并将其治疗至满。将 1 张带有[consume]的<b>欲望碎片</b>加入手牌。"
            },
            "card_type": "spell",
            "rarity": "common",
            "class": "@ClassSuccubus",
            "card_art": "@MindDominationArt",
            "cost": 2,
            "targets_room": true,
            "targetless": false,
            "pools": [
                "MegaPool"
            ],
            "effects": [
                "@MindDominationShard",
                "@MindDominationBump",
                "@MindDominationFrantic",
                "@MindDominationHeal"
            ]
        }
    ],
    "effects": [
        {
            "id": "MindDominationShard",
            "name": "CardEffectAddBattleCard",
            "target_mode": "room",
            "target_team": "none",
            "param_int": 3,
            "param_int_2": 1,
            "param_card_pool": "@ObsessingShardPool",
            "param_upgrade": "@ConsumeUpgrade"
        },
        {
            "id": "MindDominationBump",
            "name": "CardEffectBump",
            "target_mode": "drop_target_character",
            "target_team": "both",
            "param_int": -1
        },
        {
            "id": "MindDominationFrantic",
            "name": "CardEffectAddStatusEffect",
            "target_mode": "last_targeted_characters",
            "target_team": "both",
            "param_status_effects": [
                {
                    "status": "@frantic",
                    "count": 1
                }
            ]
        },
        {
            "id": "MindDominationHeal",
            "name": "CardEffectHeal",
            "target_mode": "last_targeted_characters",
            "target_team": "both",
            "param_int": 999
        }
    ],
    "sprites": [
        {
            "id": "MindDominationArt",
            "path": "textures/MindDominationArt.png"
        }
    ],
    "game_objects": [
        {
            "id": "MindDominationArt",
            "type": "card_art",
            "extensions": {
                "card_art": {
                    "sprite": "@MindDominationArt"
                }
            }
        }
    ]
}
