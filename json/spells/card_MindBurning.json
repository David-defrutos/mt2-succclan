{
    "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
    "cards": [
        {
            "id": "MindBurning",
            "names": {
                "english": "Mind Burning",
                "chinese": "意识灼烧"
            },
            "descriptions": {
                "english": "Apply <b>[mt2_succclan.Plugin_frantic] [effect0.status0.power]</b>, [dazed] [effect1.status0.power], [witherbloom] [effect2.status0.power] and [multistrike] [effect3.status0.power] to an enemy unit. Discard [effect4.power] <b>Obsessing Spark</b>.",
                "chinese": "对一个敌方单位施加 <b>[mt2_succclan.Plugin_frantic] [effect0.status0.power]</b>、[dazed] [effect1.status0.power]、[witherbloom] [effect2.status0.power] 和[multistrike] [effect3.status0.power]。舍弃 [effect4.power] 张<b>欲望碎片</b>。"
            },
            "card_type": "spell",
            "rarity": "uncommon",
            "class": "@ClassSuccubus",
            "card_art": "@MindBurningArt",
            "cost": 1,
            "targets_room": true,
            "targetless": false,
            "pools": [
                "MegaPool"
            ],
            "effects": [
                "@MindBurningFrantic",
                "@MindBurningDazed",
                "@MindBurningWither",
                "@MindBurningMulti",
                "@MindBurningSpread"
            ]
        }
    ],
    "effects": [
