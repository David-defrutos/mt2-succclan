                "german": "Verleiht einer feindlichen Einheit <b>[mt2_succclan.Plugin_frantic] [effect0.status0.power]</b> und [multistrike] [effect1.status0.power].",
                "portuguese": "Aplica <b>[mt2_succclan.Plugin_frantic] [effect0.status0.power]</b> e [multistrike] [effect1.status0.power] a uma unidade inimiga.",
                "russian": "Даёт врагу <b>[mt2_succclan.Plugin_frantic] [effect0.status0.power]</b> и [multistrike] [effect1.status0.power].",
                "chinese_traditional": "對一個敵方單位施加 <b>[mt2_succclan.Plugin_frantic] [effect0.status0.power]</b> 與 [multistrike] [effect1.status0.power]。",
                "japanese": "敵1体に<b>[mt2_succclan.Plugin_frantic] [effect0.status0.power]</b>と[multistrike] [effect1.status0.power]を付与する。",
                "korean": "적 하나에게 <b>[mt2_succclan.Plugin_frantic] [effect0.status0.power]</b> 및 [multistrike] [effect1.status0.power]을 부여합니다."
            },
            "card_type": "spell",
            "rarity": "uncommon",
            "class": "@ClassSuccubus",
            "card_art": "@MindBurningArt",
            "cost": 1,
            "targets_room": true,
            "targetless": false,
            "pools": [
                "MegaPool"
            ],
            "effects": [
                "@MindBurningFrantic",
                "@MindBurningMulti"
            ]
