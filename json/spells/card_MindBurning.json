{
    "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
    "cards": [
        {
            "id": "MindBurning",
            "names": {
                "english": "Mind Burning",
                "chinese": "意识灼烧"
            },
            "descriptions": {
                "english": "Apply <b>[mt2_succclan.Plugin_frantic] [effect0.status0.power]</b> and [multistrike] [effect1.status0.power] to an enemy unit.",
                "chinese": "对一个敌方单位施加 <b>[mt2_succclan.Plugin_frantic] [effect0.status0.power]</b> 和[multistrike] [effect1.status0.power]。"
            },
            "card_type": "spell",
            "rarity": "uncommon",
            "class": "@ClassSuccubus",
            "card_art": "@MindBurningArt",
            "cost": 1,
            "targets_room": true,
            "targetless": false,
            "pools": [
                "MegaPool"
            ],
            "effects": [
                "@MindBurningFrantic",
                "@MindBurningMulti"
            ]
        }
    ],
    "effects": [
        {
            "id": "MindBurningFrantic",
            "name": "CardEffectAddStatusEffect",
            "target_mode": "drop_target_character",
            "target_team": "heroes",
            "param_status_effects": [
                {
                    "status": "@frantic",
                    "count": 1
                }
            ]
        },
        {
            "id": "MindBurningMulti",
            "name": "CardEffectAddStatusEffect",
            "target_mode": "last_targeted_characters",
            "target_team": "heroes",
            "param_status_effects": [
                {
                    "status": "multistrike",
                    "count": 1
                }
            ]
        }
    ],
    "sprites": [
        {
            "id": "MindBurningArt",
            "path": "textures/MindBurningArt.png"
        }
    ],
    "game_objects": [
        {
            "id": "MindBurningArt",
            "type": "card_art",
            "extensions": {
                "card_art": {
                    "sprite": "@MindBurningArt"
                }
            }
        }
    ]
}
