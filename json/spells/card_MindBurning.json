            "target_team": "heroes",
            "param_status_effects": [
                {
                    "status": "@frantic",
                    "count": 1
                }
            ]
        },
        {
            "id": "MindBurningMulti",
            "name": "CardEffectAddStatusEffect",
            "target_mode": "last_targeted_characters",
            "target_team": "heroes",
            "param_status_effects": [
                {
                    "status": "multistrike",
                    "count": 1
                }
            ]
        }
    ],
    "sprites": [
        {
            "id": "MindBurningArt",
            "path": "textures/MindBurningArt.png"
        }
    ],
    "game_objects": [
        {
            "id": "MindBurningArt",
