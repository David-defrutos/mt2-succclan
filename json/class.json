                "r": 1.0,
                "g": 0.525,
                "b": 0.7
            },
            "ui_color_dark": {
                "r": 0.55,
                "g": 0.1,
                "b": 0.5
            },
            "ui_gradient": [
                {
                    "time": 0.0,
                    "color": {
                        "r": 0.55,
                        "g": 0.1,
                        "b": 0.5
                    }
                },
                {
                    "time": 1.0,
                    "color": {
                        "r": 1.0,
                        "g": 0.525,
                        "b": 0.7
                    }
                }
            ],
            "champions": [
                {
                    "id": "KnightMareChampion",
                    "card_data": "@SpawnKnightMare",
                    "starter_card": "@Inception",
                    "upgrade_tree": [
                        [
                            "@upg_AbyssBasic",
                            "@upg_AbyssPre",
                            "@upg_AbyssPro"
                        ],
                        [
                            "@upg_EndlessBasic",
                            "@upg_EndlessPre",
                            "@upg_EndlessPro"
                        ],
                        [
                            "@upg_IllusionBasic",
                            "@upg_IllusionPre",
                            "@upg_IllusionPro"
                        ]
                    ],
                    "icon": "@icon_KnightMare",
                    "portrait": "@portrait_KnightMare"
                },
                {
                    "id": "ShadowLadyChampion",
                    "card_data": "@SpawnShadowLady",
                    "starter_card": "@Flogging",
                    "upgrade_tree": [
                        [
                            "@upg_BloodThirstyBasic",
                            "@upg_BloodThirstyPre",
                            "@upg_BloodThirstyPro"
                        ],
                        [
                            "@upg_PlagueBasic",
                            "@upg_PlaguePre",
                            "@upg_PlaguePro"
                        ],
                        [
                            "@upg_ProfanityBasic",
                            "@upg_ProfanityPre",
                            "@upg_ProfanityPro"
                        ]
                    ],
                    "icon": "@icon_ShadowLady",
                    "portrait": "@portrait_ShadowLady"
                }
            ],
            "is_crew": false,
            "class_select_character_displays": [
                "@KnightMareClassDisplayArt",
                "@ShadowLadyClassDisplayArt"
            ]
        }
