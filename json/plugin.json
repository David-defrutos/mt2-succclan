{
    "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
    "card_pools": [
        {
            "id": "ObsessingShardPool",
            "cards": [
                "@ObsessingShard"
            ]
        }
    ],
    "traits": [
        {
            "id": "Consume",
            "name": "CardTraitExhaustState"
        },
        {
            "id": "SelfPurge",
            "name": "CardTraitSelfPurge"
        },
        {
            "id": "Piercing",
            "name": "CardTraitIgnoreArmor"
        },
        {
            "id": "Attuned",
            "name": "CardTraitStrongerMagicPower",
            "param_int": 5
        },
        {
            "id": "Pyrebound",
            "name": "CardTraitLimitedRange"
        },
        {
            "id": "Frozen",
            "name": "CardTraitFreeze"
        },
        {
            "id": "CubusSpikeScaling",
            "name": "CardTraitScalingAddStatusEffect",
            "param_tracked_value": "played_cost",
            "param_entry_duration": "this_battle",
            "param_int": 2,
            "param_team": "heroes",
            "param_status_effects": [
                {
                    "status": "@frantic",
                    "count": 0
                }
            ]
        },
        {
            "id": "PlagueBoostScaling",
            "name": "CardTraitScalingAddEnergy",
            "param_tracked_value": "type_in_deck",
            "param_card_type": "blight",
            "param_int": 1
        },
        {
            "id": "VitalityScalingRegen",
            "name": "CardTraitScalingAddStatusEffect",
            "param_tracked_value": "status_effect_count_in_target_room",
            "param_int": 1,
            "param_team": "monsters",
            "param_status_effects": [
                {
                    "status": "regen",
                    "count": 0
                }
            ]
        },
        {
            "id": "VitalityScalingBuff",
            "name": "CardTraitScalingAddStatusEffect",
            "param_tracked_value": "status_effect_count_in_target_room",
            "param_int": 1,
            "param_team": "monsters",
            "param_status_effects": [
                {
                    "status": "buff",
                    "count": 0
                }
            ]
        }
    ],
    "upgrades": [
        {
            "id": "ConsumeUpgrade",
            "trait_upgrades": [
                "@Consume"
            ]
        },
        {
            "id": "IllusionTwinsFragile",
            "status_effect_upgrades": [
                {
                    "status": "fragile",
                    "count": 1
                }
            ]
        },
        {
            "id": "EndlessShadowWeaker",
            "bonus_hp": -5
        },
        {
            "id": "ShadowWarriorPermanentAttack",
            "bonus_damage": 2
        }
    ],
    "additional_tooltips": [
        {
            "id": "PsionicBurstTooltip",
            "titles": {
                "english": "Psionic Burst",
                "chinese": "灵能爆破"
            },
            "descriptions": {
                "english": "Reduce <b>Psionic</b> for additional ability.",
                "chinese": "消耗相应层数的 <b>灵能</b> 以触发额外效果。"
            },
            "style": "keyword",
            "allow_secondary_placement": true
        }
    ]
}
