{
    "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
    "relics": [
        {
            "id": "FleshRing",
            "type": "collectable",
            "names": {
                "english": "Flesh Ring",
                "chinese": "血肉之灾"
            },
            "descriptions": {
                "english": "The first <b>Blight</b> you play each turn draws you [effect0.power] card.",
                "chinese": "每回合首次打出[blight]牌时，抽 [effect0.power] 张牌。"
            },
            "disallow_in_deployment": false,
            "relic_effects": [
                "@FleshRingEffect"
            ],
            "icon": "@FleshRingIcon",
            "icon_small": "@FleshRingIcon",
            "extensions": [
                {
                    "collectable": {
                        "class": "@ClassSuccubus",
                        "pools": [
                            "MegaRelicPool"
                        ],
                        "rarity": "common",
                        "unlock_level": 0
                    }
                }
            ]
        }
    ],
    "relic_effects": [
        {
            "id": "FleshRingEffect",
            "name": "RelicEffectCardDrawOnCardPlay",
            "param_card_type": "blight",
            "param_int": 1,
            "conditions": [
                {
                    "id": "@FleshRingOncePerTurn"
                }
            ]
        }
    ],
    "relic_effect_conditions": [
        {
            "id": "FleshRingOncePerTurn",
            "param_track_trigger_count": true,
            "allow_multiple_triggers_per_duration": false,
            "param_entry_duration": "this_turn",
            "param_int": 1
        }
    ],
    "sprites": [
        {
            "id": "FleshRingIcon",
            "path": "textures/FleshRingArt.png"
        }
    ]
}
