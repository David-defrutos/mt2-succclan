{
    "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
    "relics": [
        {
            "id": "PoisonSerum",
            "type": "collectable",
            "names": {
                "english": "Poison Serum",
                "chinese": "瘟疫血清"
            },
            "descriptions": {
                "english": "Draw [effect0.power] extra card each turn. At the start of each turn add an <b>Obsessing Spark</b> to your hand.",
                "chinese": "每回合多抽 [effect0.power] 张牌。回合开始时，将一张<b>欲望碎片</b>加入手牌。"
            },
            "disallow_in_deployment": false,
            "relic_effects": [
                "@PoisonSerumHandSize",
                "@PoisonSerumShard"
            ],
            "icon": "@PoisonSerumIcon",
            "icon_small": "@PoisonSerumIcon",
            "extensions": [
                {
                    "collectable": {
                        "class": "@ClassSuccubus",
                        "pools": [
                            "MegaRelicPool"
                        ],
                        "rarity": "common",
                        "unlock_level": 0
                    }
                }
            ]
        }
    ],
    "relic_effects": [
        {
            "id": "PoisonSerumHandSize",
            "name": "RelicEffectChangeStartingHandSize",
            "param_int": 1
        },
        {
            "id": "PoisonSerumShard",
            "name": "RelicEffectAddPrecachedBattleCardToHand",
            "param_card_pool": "@ObsessingShardPool"
        }
    ],
    "sprites": [
        {
            "id": "PoisonSerumIcon",
            "path": "textures/PoisonSerumArt.png"
        }
    ]
}
