{
    "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
    "cards": [
        {
            "id": "SpawnEndlessShadow",
            "names": {
                "english": "Endless Shadow",
                "chinese": "无尽幽影",
                "spanish": "Sombra interminable",
                "french": "Ombre sans fin",
                "german": "Endloser Schatten",
                "portuguese": "Sombra Infindável",
                "russian": "Бесконечная тень",
                "chinese_traditional": "無盡暗影",
                "japanese": "無限の影",
                "korean": "끝없는 그림자"
            },
            "card_art": "@EndlessShadowCardArt",
            "cost": 1,
            "card_type": "monster",
            "rarity": "rare",
            "class": "@ClassSuccubus",
            "targets_room": true,
            "pools": [
                "UnitsAllBanner"
            ],
            "effects": [
                "@SpawnEndlessShadow"
            ]
        }
    ],
    "characters": [
        {
            "id": "EndlessShadow",
            "attack_vfx": "@SuccFXBladeAttack",
            "impact_vfx": "@SuccFXShadowImpact",
            "death_vfx": "@SuccFXDeathSmoke",
            "names": {
                "english": "Endless Shadow",
                "chinese": "无尽幽影",
                "spanish": "Sombra interminable",
                "french": "Ombre sans fin",
                "german": "Endloser Schatten",
                "portuguese": "Sombra Infindável",
                "russian": "Бесконечная тень",
                "chinese_traditional": "無盡暗影",
                "japanese": "無限の影",
                "korean": "끝없는 그림자"
            },
            "character_art": "@EndlessShadowCharacterArt",
            "size": 2,
            "attack_damage": 10,
            "health": 15,
            "subtypes": [
                "SubtypesData_BannerUnit",
                "@Sub_Cubus"
            ],
            "triggers": [
                "@EndlessShadowOnDeath"
            ]
        }
    ],
    "character_triggers": [
        {
            "id": "EndlessShadowOnDeath",
            "trigger": "on_death",
            "descriptions": {
                "english": "Summon another Endless Shadow in this room with 5 less max [health], if it would have at least 1 [health].",
                "spanish": "Invoca otra Sombra interminable en esta sala con 5 menos de [health] máxima, si tendría al menos 1 de [health].",
                "chinese": "在本层召唤另一个最大[health]减少 5 点的无尽幽影，前提是其至少拥有 1 点[health]。",
                "chinese_traditional": "在本層召喚另一個最大[health]減少 5 點的無盡暗影，前提是其至少擁有 1 點[health]。",
                "french": "Invoque une autre Ombre sans fin dans cette salle avec 5 de [health] maximum en moins, si elle aurait au moins 1 [health].",
                "german": "Beschwört einen weiteren Endlosen Schatten in diesem Raum mit 5 weniger maximaler [health], sofern er mindestens 1 [health] hätte.",
                "portuguese": "Invoca outra Sombra Infindável nesta sala com 5 a menos de [health] máxima, se ela tiver pelo menos 1 de [health].",
                "russian": "Призывает ещё одну Бесконечную тень в этой комнате с максимальным [health] на 5 меньше, если у неё будет хотя бы 1 [health].",
                "japanese": "この部屋に最大[health]が5低い無限の影をもう1体召喚する。ただし、[health]が1以上残る場合のみ。",
                "korean": "이 방에 최대 [health]이 5 낮은 끝없는 그림자 하나를 더 소환합니다. 단, [health]이 1 이상 남는 경우에만 소환합니다."
            },
            "effects": [
                "@EndlessShadowSpawn"
            ]
        }
    ],
    "effects": [
        {
            "id": "SpawnEndlessShadow",
            "name": "CardEffectSpawnMonster",
            "target_mode": "drop_target_character",
            "param_character": "@EndlessShadow"
        },
        {
            "id": "EndlessShadowSpawn",
            "name": "@CardEffectEndlessShadowRebirth",
            "target_mode": "room",
            "target_team": "monsters",
            "param_character": "@EndlessShadow",
            "param_upgrade": "@EndlessShadowWeaker"
        }
    ],
    "sprites": [
        {
            "id": "EndlessShadowCardArt",
            "path": "textures/EndlessShadowCardArt.png"
        },
        {
            "id": "EndlessShadowCharacterArt",
            "path": "textures/EndlessShadowCharacterArt.png"
        }
    ],
    "game_objects": [
        {
            "id": "EndlessShadowCardArt",
            "type": "card_art",
            "extensions": {
                "card_art": {
                    "sprite": "@EndlessShadowCardArt"
                }
            }
        },
        {
            "id": "EndlessShadowCharacterArt",
            "type": "character_art",
            "extensions": {
                "character_art": {
                    "sprite": "@EndlessShadowCharacterArt",
                    "transform": {
                        "position": {
                            "x": 0,
                            "y": 1.0,
                            "z": 0.1
                        },
                        "scale": {
                            "x": 0.85,
                            "y": 0.85,
                            "z": 1
                        }
                    }
                }
            }
        }
    ]
}
