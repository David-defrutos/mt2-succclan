    "character_triggers": [
        {
            "id": "DemonPioneerAccursed",
            "trigger": {
                "id": "@Accursed",
                "mod_reference": "Conductor"
            },
            "descriptions": {
                "english": "+[effect0.power][attack] and +[effect1.power][health]. Permanently +[effect2.upgrade.bonusdamage][attack] and +[effect2.upgrade.bonushp][health].",
                "chinese": "+[effect0.power][attack]，+[effect1.power][health]。永久 +[effect2.upgrade.bonusdamage][attack]，+[effect2.upgrade.bonushp][health]。",
                "spanish": "+[effect0.power][attack] y +[effect1.power][health]. +[effect2.upgrade.bonusdamage][attack] y +[effect2.upgrade.bonushp][health] permanentemente.",
                "french": "+[effect0.power][attack] et +[effect1.power][health]. +[effect2.upgrade.bonusdamage][attack] et +[effect2.upgrade.bonushp][health] de façon permanente.",
                "german": "+[effect0.power][attack] und +[effect1.power][health]. Dauerhaft +[effect2.upgrade.bonusdamage][attack] und +[effect2.upgrade.bonushp][health].",
                "portuguese": "+[effect0.power][attack] e +[effect1.power][health]. +[effect2.upgrade.bonusdamage][attack] e +[effect2.upgrade.bonushp][health] permanentemente.",
                "russian": "+[effect0.power][attack] и +[effect1.power][health]. Навсегда +[effect2.upgrade.bonusdamage][attack] и +[effect2.upgrade.bonushp][health].",
                "chinese_traditional": "+[effect0.power][attack] 與 +[effect1.power][health]。永久 +[effect2.upgrade.bonusdamage][attack] 與 +[effect2.upgrade.bonushp][health]。",
                "japanese": "+[effect0.power][attack]と+[effect1.power][health]。永続的に+[effect2.upgrade.bonusdamage][attack]と+[effect2.upgrade.bonushp][health]。",
                "korean": "+[effect0.power][attack] 및 +[effect1.power][health]. 영구적으로 +[effect2.upgrade.bonusdamage][attack] 및 +[effect2.upgrade.bonushp][health]."
            },
            "effects": [
                "@DemonPioneerAttack",
                "@DemonPioneerHealth",
                "@DemonPioneerPermanentBuff"
            ]
        }
    ],
    "effects": [
        {
            "id": "SpawnDemonPioneer",
            "name": "CardEffectSpawnMonster",
            "target_mode": "drop_target_character",
            "param_character": "@DemonPioneer"
        },
        {
            "id": "DemonPioneerAttack",
            "applied_vfx": "@SuccFXAttackBuff",
            "name": "CardEffectBuffDamage",
            "target_mode": "self",
            "target_team": "monsters",
            "param_int": 1
        },
        {
            "id": "DemonPioneerHealth",
            "applied_vfx": "@SuccFXHealthBuff",
            "name": "CardEffectBuffMaxHealth",
            "target_mode": "self",
            "target_team": "monsters",
            "param_int": 3
        },
        {
            "id": "DemonPioneerPermanentBuff",
            "applied_vfx": "@SuccFXPsionicPulse",
            "name": "CardEffectAddCardUpgradeToUnits",
            "target_mode": "self",
            "target_team": "monsters",
            "param_upgrade": "@DemonPioneerPermanent",
            "param_int_3": 2
        }
    ],
    "sprites": [
        {
            "id": "DemonPioneerCardArt",
