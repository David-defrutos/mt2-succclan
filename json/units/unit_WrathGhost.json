            },
            "effects": [
                "@WrathGhostAddShards"
            ]
        },
        {
            "id": "WrathGhostAccursed",
            "trigger": {
                "id": "@Accursed",
                "mod_reference": "Conductor"
            },
            "descriptions": {
                "english": "Apply +[effect0.power][attack] to friendly units.",
                "chinese": "所有友方单位获得 +[effect0.power][attack]。"
            },
            "effects": [
                "@WrathGhostBuff"
            ]
        }
    ],
    "effects": [
        {
            "id": "SpawnWrathGhost",
            "name": "CardEffectSpawnMonster",
            "target_mode": "drop_target_character",
            "param_character": "@WrathGhost"
        },
        {
            "id": "WrathGhostAddShards",
            "name": "CardEffectAddBattleCard",
            "target_mode": "room",
            "target_team": "none",
            "param_int": 3,
            "param_int_2": 2,
            "param_card_pool": "@ObsessingShardPool",
            "param_upgrade": "@ConsumeUpgrade"
