                "@WrathGhostOnSpawn",
                "@WrathGhostAccursed"
            ]
        }
    ],
    "character_triggers": [
        {
            "id": "WrathGhostOnSpawn",
            "trigger": "on_spawn",
            "descriptions": {
                "english": "Add [effect0.secondarypower] <b>Obsessing Spark</b> with [consume] to your hand.",
