{
    "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
    "cards": [
        {
            "id": "SpawnEnvyGhost",
            "names": {
                "english": "Envy Ghost",
                "chinese": "嫉妒幽魂"
            },
            "card_type": "monster",
            "rarity": "common",
            "class": "@ClassSuccubus",
            "card_art": "@EnvyGhostCardArt",
            "cost": 0,
            "targets_room": true,
            "pools": [
                "MegaPool"
            ],
            "effects": [
                "@SpawnEnvyGhost"
            ]
        }
    ],
    "characters": [
        {
            "id": "EnvyGhost",
            "names": {
                "english": "Envy Ghost",
                "chinese": "嫉妒幽魂"
            },
            "character_art": "@EnvyGhostCharacterArt",
            "size": 1,
            "attack_damage": 0,
            "health": 2,
            "subtypes": [
                "@Sub_Ghost"
            ],
            "triggers": [
                "@EnvyGhostOnSpawn",
                "@EnvyGhostAccursed"
            ]
        }
    ],
    "character_triggers": [
        {
            "id": "EnvyGhostOnSpawn",
            "trigger": "on_spawn",
            "descriptions": {
                "english": "Add [effect0.power_unmodified] <b>Obsessing Spark</b> with [consume] to your hand.",
                "chinese": "将 [effect0.power_unmodified] 张带有[consume]的<b>欲望碎片</b>加入手牌。"
            },
            "effects": [
                "@EnvyGhostAddShards"
            ]
        },
        {
            "id": "EnvyGhostAccursed",
            "trigger": {
                "id": "@Accursed",
                "mod_reference": "Conductor"
            },
            "descriptions": {
                "english": "Deal [effect0.power] damage to the front enemy unit.",
                "chinese": "对前排敌方单位造成 [effect0.power] 点伤害。"
            },
            "effects": [
                "@EnvyGhostDamage"
            ]
        }
    ],
    "effects": [
        {
            "id": "SpawnEnvyGhost",
            "name": "CardEffectSpawnMonster",
            "target_mode": "drop_target_character",
            "param_character": "@EnvyGhost"
        },
        {
            "id": "EnvyGhostAddShards",
            "name": "CardEffectAddBattleCard",
            "target_mode": "room",
            "target_team": "none",
            "param_int": 3,
            "param_int_2": 2,
            "param_card_pool": "@ObsessingShardPool",
            "param_upgrade": "@ConsumeUpgrade"
        },
        {
            "id": "EnvyGhostDamage",
            "name": "CardEffectDamage",
            "target_mode": "front_in_room",
            "target_team": "heroes",
            "param_int": 20
        }
    ],
    "sprites": [
        {
            "id": "EnvyGhostCardArt",
            "path": "textures/EnvyGhostCardArt.png"
        },
        {
            "id": "EnvyGhostCharacterArt",
            "path": "textures/EnvyGhostCharacterArt.png"
        }
    ],
    "game_objects": [
        {
            "id": "EnvyGhostCardArt",
            "type": "card_art",
            "extensions": {
                "card_art": {
                    "sprite": "@EnvyGhostCardArt"
                }
            }
        },
        {
            "id": "EnvyGhostCharacterArt",
            "type": "character_art",
            "extensions": {
                "character_art": {
                    "sprite": "@EnvyGhostCharacterArt",
                    "transform": {
                        "position": {
                            "x": 0,
                            "y": 0.6,
                            "z": 0.1
                        },
                        "scale": {
                            "x": 1.0,
                            "y": 1.0,
                            "z": 1
                        }
                    }
                }
            }
        }
    ]
}
