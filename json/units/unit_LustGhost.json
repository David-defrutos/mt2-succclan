{
    "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
    "cards": [
        {
            "id": "SpawnLustGhost",
            "names": {
                "english": "Lust Ghost",
                "chinese": "色欲幽魂"
            },
            "card_type": "monster",
            "rarity": "common",
            "class": "@ClassSuccubus",
            "card_art": "@LustGhostCardArt",
            "cost": 0,
            "targets_room": true,
            "pools": [
                "MegaPool"
            ],
            "effects": [
                "@SpawnLustGhost"
            ]
        }
    ],
    "characters": [
        {
            "id": "LustGhost",
            "names": {
                "english": "Lust Ghost",
                "chinese": "色欲幽魂"
            },
            "character_art": "@LustGhostCharacterArt",
            "size": 1,
            "attack_damage": 0,
            "health": 2,
            "subtypes": [
                "@Sub_Ghost"
            ],
            "triggers": [
                "@LustGhostOnSpawn",
                "@LustGhostAccursed"
            ]
        }
    ],
    "character_triggers": [
        {
            "id": "LustGhostOnSpawn",
            "trigger": "on_spawn",
            "descriptions": {
                "english": "Add [effect0.power_unmodified] <b>Obsessing Spark</b> with [consume] to your hand.",
                "chinese": "将 [effect0.power_unmodified] 张带有[consume]的<b>欲望碎片</b>加入手牌。"
            },
            "effects": [
                "@LustGhostAddShards"
            ]
        },
        {
            "id": "LustGhostAccursed",
            "trigger": {
                "id": "@Accursed",
                "mod_reference": "Conductor"
            },
            "descriptions": {
                "english": "Apply <b>[mt2_succclan.Plugin_frantic] [effect0.status0.power]</b> to the back enemy unit.",
                "chinese": "对后排敌方单位施加 <b>[mt2_succclan.Plugin_frantic] [effect0.status0.power]</b>。"
            },
            "effects": [
                "@LustGhostFrantic"
            ]
        }
    ],
    "effects": [
        {
            "id": "SpawnLustGhost",
            "name": "CardEffectSpawnMonster",
            "target_mode": "drop_target_character",
            "param_character": "@LustGhost"
        },
        {
            "id": "LustGhostAddShards",
            "name": "CardEffectAddBattleCard",
            "target_mode": "room",
            "target_team": "none",
            "param_int": 3,
            "param_int_2": 2,
            "param_card_pool": "@ObsessingShardPool",
            "param_upgrade": "@ConsumeUpgrade"
        },
        {
            "id": "LustGhostFrantic",
            "name": "CardEffectAddStatusEffect",
            "target_mode": "back_in_room",
            "target_team": "heroes",
            "param_status_effects": [
                {
                    "status": "@frantic",
                    "count": 1
                }
            ]
        }
    ],
    "sprites": [
        {
            "id": "LustGhostCardArt",
            "path": "textures/LustGhostCardArt.png"
        },
        {
            "id": "LustGhostCharacterArt",
            "path": "textures/LustGhostCharacterArt.png"
        }
    ],
    "game_objects": [
        {
            "id": "LustGhostCardArt",
            "type": "card_art",
            "extensions": {
                "card_art": {
                    "sprite": "@LustGhostCardArt"
                }
            }
        },
        {
            "id": "LustGhostCharacterArt",
            "type": "character_art",
            "extensions": {
                "character_art": {
                    "sprite": "@LustGhostCharacterArt",
                    "transform": {
                        "position": {
                            "x": 0,
                            "y": 0.6,
                            "z": 0.1
                        },
                        "scale": {
                            "x": 1.0,
                            "y": 1.0,
                            "z": 1
                        }
                    }
                }
            }
        }
    ]
}
