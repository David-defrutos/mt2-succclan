{
    "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
    "cards": [
        {
            "id": "SpawnGluttonyGhost",
            "names": {
                "english": "Gluttony Ghost",
                "chinese": "暴食幽魂"
            },
            "card_type": "monster",
            "rarity": "common",
            "class": "@ClassSuccubus",
            "card_art": "@GluttonyGhostCardArt",
            "cost": 0,
            "targets_room": true,
            "pools": [
                "MegaPool"
            ],
            "effects": [
                "@SpawnGluttonyGhost"
            ],
            "traits": [
                "@GluttonyGhostDeploy"
            ]
        }
    ],
    "characters": [
        {
            "id": "GluttonyGhost",
            "names": {
                "english": "Gluttony Ghost",
                "chinese": "暴食幽魂"
            },
            "character_art": "@GluttonyGhostCharacterArt",
            "size": 1,
            "attack_damage": 0,
            "health": 2,
            "subtypes": [
                "@Sub_Ghost"
            ],
            "triggers": [
                "@GluttonyGhostOnSpawn",
                "@GluttonyGhostAccursed"
            ]
        }
    ],
    "character_triggers": [
        {
            "id": "GluttonyGhostOnSpawn",
            "trigger": "on_spawn",
            "descriptions": {
                "english": "Add [effect0.power_unmodified] <b>Obsessing Spark</b> with [consume] to your hand.",
                "chinese": "将 [effect0.power_unmodified] 张带有[consume]的<b>欲望碎片</b>加入手牌。"
            },
            "effects": [
                "@GluttonyGhostAddShards"
            ]
        },
        {
            "id": "GluttonyGhostAccursed",
            "trigger": {
                "id": "@Accursed",
                "mod_reference": "Conductor"
            },
            "descriptions": {
                "english": "Apply [regen] [effect0.status0.power] to friendly units.",
                "chinese": "友方单位获得[regen] [effect0.status0.power]。"
            },
            "effects": [
                "@GluttonyGhostRegen"
            ]
        }
    ],
    "effects": [
        {
            "id": "SpawnGluttonyGhost",
            "name": "CardEffectSpawnMonster",
            "target_mode": "drop_target_character",
            "param_character": "@GluttonyGhost"
        },
        {
            "id": "GluttonyGhostAddShards",
            "name": "CardEffectAddBattleCard",
            "target_mode": "room",
            "target_team": "none",
            "param_int": 3,
            "param_int_2": 2,
            "param_card_pool": "@ObsessingShardPool",
            "param_upgrade": "@ConsumeUpgrade"
        },
        {
            "id": "GluttonyGhostRegen",
            "name": "CardEffectAddStatusEffect",
            "target_mode": "room",
            "target_team": "monsters",
            "param_status_effects": [
                {
                    "status": "regen",
                    "count": 2
                }
            ]
        }
    ],
    "sprites": [
        {
            "id": "GluttonyGhostCardArt",
            "path": "textures/GluttonyGhostCardArt.png"
        },
        {
            "id": "GluttonyGhostCharacterArt",
            "path": "textures/GluttonyGhostCharacterArt.png"
        }
    ],
    "game_objects": [
        {
            "id": "GluttonyGhostCardArt",
            "type": "card_art",
            "extensions": {
                "card_art": {
                    "sprite": "@GluttonyGhostCardArt"
                }
            }
        },
        {
            "id": "GluttonyGhostCharacterArt",
            "type": "character_art",
            "extensions": {
                "character_art": {
                    "sprite": "@GluttonyGhostCharacterArt",
                    "transform": {
                        "position": {
                            "x": 0,
                            "y": 0.4,
                            "z": 0.1
                        },
                        "scale": {
                            "x": 1.0,
                            "y": 1.0,
                            "z": 1
                        }
                    }
                }
            }
        }
    ],
    "traits": [
        {
            "id": "GluttonyGhostDeploy",
            "name": "CardTraitDrawInDeploymentPhase"
        }
    ]
}
