        {
            "id": "EssenceArroganceGhost",
            "titles": {
                "english": "Arrogance Ghost",
                "chinese": "傲慢幽魂"
            },
            "descriptions": {
                "english": "Add [effect0.power_unmodified] <b>Obsessing Spark</b> with [consume] to your hand. <b>Accursed</b>: gain [effect1.power][ember] and draw [effect2.power] more next turn.",
                "chinese": "将 [effect0.power_unmodified] 张带有[consume]的<b>欲望碎片</b>加入手牌。<b>被咒</b>：获得 [effect1.power][ember]，下回合多抽 [effect2.power] 张牌。"
            },
            "use_upgrade_highlight_tags": true,
            "trigger_upgrades": [
                "@EssenceShardOnSpawn",
                "@EssenceArroganceAccursed"
            ]
        },
