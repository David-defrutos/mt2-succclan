<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>mt2_succclan.Plugin</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>0.1.14</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HarmonyX" Version="2.7.0" />
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="MonsterTrain2.Api" Version="4.11.22787024" />
    <PackageReference Include="TrainworksReloaded.Base" Version="0.7.35" />
    <PackageReference Include="Conductor" Version="0.5.17" />
  </ItemGroup>

  <!-- Sin reglas de copia de json/ ni textures/: en este repo cuelgan de la raiz
       (la carpeta del plugin), no de src/. El build solo produce el DLL. -->
</Project>
